{
  "name": "@spvi/central",
  "version": "1.0.0",
  "private": true,
  "description": "SPVI Central: panel del proveedor (soporte, errores, anuncios, versiones e instalaciones)",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/throttler": "^6.2.0",
    "@prisma/client": "^6.2.0",
    "argon2": "^0.41.0",
    "helmet": "^8.0.0",
    "prisma": "^6.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
