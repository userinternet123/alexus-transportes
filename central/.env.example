# SPVI Central — copie a .env y complete
DOMINIO=central.sudominio.com
POSTGRES_PASSWORD=cambie-esta-clave-larga
DATABASE_URL=postgresql://central:cambie-esta-clave-larga@db:5432/central?schema=public
# Genere con: openssl rand -hex 32
JWT_SECRET=
# Primer usuario del panel (solo se usa si no existe ninguno)
ADMIN_EMAIL=soporte@sudominio.com
ADMIN_PASSWORD=
LATIDO_HORAS=6
# Con Tailscale Funnel (sin dominio): la dirección pública que usan las tiendas
# URL_PUBLICA=https://mi-pc.mi-red.ts.net

# ── Con dominio propio y túnel de Cloudflare (recomendado) ──
# Panel privado: https://central.alexusgt.com  ·  Tiendas: https://agentes.alexusgt.com
URL_PUBLICA=https://agentes.alexusgt.com
HOST_AGENTES=agentes.alexusgt.com
# Token del túnel (Cloudflare › Networking › Tunnels). Con COMPOSE_PROFILES se inicia el túnel junto con Central.
COMPOSE_PROFILES=cloudflare
CF_TUNNEL_TOKEN=
