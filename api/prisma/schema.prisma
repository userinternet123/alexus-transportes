// =============================================================================
// ALEXUS Transportes — Modelo de datos
// -----------------------------------------------------------------------------
// Derivado de la plataforma SPVI 2.0 (seguridad, licencias, RRHH, gastos,
// notificaciones) con el dominio de una empresa de transporte pesado:
// cabezales, remolques, pilotos, viajes, combustible, llantas y taller.
//
// Principios:
//  1. UNA base de datos para todas las sedes (Sucursal = sede/base de
//     operaciones). Toda transacción lleva sucursalId.
//  2. El VIAJE es el centro: todo costo se asigna a un viaje o se prorratea
//     por kilómetro. De ahí sale la ganancia real por viaje, cabezal, piloto
//     y cliente.
//  3. Montos Decimal(14,2), kilómetros Decimal(12,1), galones Decimal(10,3).
//  4. Usuarios != Personas. Contraseñas con Argon2id. Permisos granulares.
//  5. Auditoría transversal (AuditLog).
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── PLATAFORMA ─────────────────────────────────

model Empresa {
  id              Int        @id @default(autoincrement())
  nombre          String
  nombreComercial String?    @map("nombre_comercial")
  nit             String     @unique
  direccion       String?
  telefono        String?
  email           String?
  logoUrl         String?    @map("logo_url")
  activo          Boolean    @default(true)
  creadoEn        DateTime   @default(now()) @map("creado_en")
  actualizadoEn   DateTime   @updatedAt @map("actualizado_en")
  sucursales      Sucursal[]

  @@map("empresas")
}

/// Sede o base de operaciones (predio, oficina, patio de cabezales).
model Sucursal {
  id            Int      @id @default(autoincrement())
  empresaId     Int      @map("empresa_id")
  codigo        String   @unique
  nombre        String
  direccion     String?
  telefono      String?
  municipioId   Int?     @map("municipio_id")
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  empresa      Empresa            @relation(fields: [empresaId], references: [id])
  municipio    Municipio?         @relation(fields: [municipioId], references: [id])
  usuarios     UsuarioSucursal[]
  empleados    Empleado[]
  gastos       Gasto[]
  cabezales    Cabezal[]
  viajes       Viaje[]
  cargas       CargaCombustible[]
  ordenes      OrdenTrabajo[]
  inspecciones Inspeccion[]
  casos        Caso[]

  @@map("sucursales")
}

/// Parámetros configurables sin desplegar código (IGSS, factor de hora extra, margen objetivo...)
model ParametroSistema {
  clave         String   @id
  valor         String
  tipo          String   @default("string") // string | number | boolean | json
  modulo        String
  descripcion   String?
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("parametros_sistema")
}

// ───────────────────────────── SEGURIDAD / RBAC ─────────────────────────────

model Usuario {
  id                  Int       @id @default(autoincrement())
  username            String    @unique
  email               String?   @unique
  nombre              String
  passwordHash        String    @map("password_hash")
  debeCambiarPassword Boolean   @default(false) @map("debe_cambiar_password")
  intentosFallidos    Int       @default(0) @map("intentos_fallidos")
  bloqueadoHasta      DateTime? @map("bloqueado_hasta")
  ultimoLogin         DateTime? @map("ultimo_login")
  empleadoId          Int?      @unique @map("empleado_id")
  activo              Boolean   @default(true)
  creadoEn            DateTime  @default(now()) @map("creado_en")
  actualizadoEn       DateTime  @updatedAt @map("actualizado_en")

  empleado            Empleado?          @relation(fields: [empleadoId], references: [id])
  roles               UsuarioRol[]
  sucursales          UsuarioSucursal[]
  sesiones            SesionRefresh[]
  gastos              Gasto[]
  viajesCreados       Viaje[]            @relation("ViajeCreadoPor")
  costosRegistrados   CostoViaje[]
  cargasRegistradas   CargaCombustible[]
  ordenesCreadas      OrdenTrabajo[]
  anticiposEntregados AnticipoViaje[]
  viajesLiquidados    Viaje[]            @relation("ViajeLiquidadoPor")
  inspecciones        Inspeccion[]
  casosCreados        Caso[]             @relation("CasoCreadoPor")
  casosAsignados      Caso[]             @relation("CasoResponsable")
  notasCaso           CasoNota[]
  cotizaciones        Cotizacion[]
  eventosViaje        EventoViaje[]
  evidencias          Evidencia[]

  @@map("usuarios")
}

model Rol {
  id          Int          @id @default(autoincrement())
  nombre      String       @unique
  descripcion String?
  esSistema   Boolean      @default(false) @map("es_sistema") // no editable/eliminable
  activo      Boolean      @default(true)
  permisos    RolPermiso[]
  usuarios    UsuarioRol[]

  @@map("roles")
}

/// Permiso granular "modulo.accion" (ej. viajes.crear, combustible.registrar)
model Permiso {
  id          Int          @id @default(autoincrement())
  codigo      String       @unique
  modulo      String
  descripcion String
  roles       RolPermiso[]

  @@map("permisos")
}

model RolPermiso {
  rolId     Int     @map("rol_id")
  permisoId Int     @map("permiso_id")
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso   Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@map("roles_permisos")
}

model UsuarioRol {
  usuarioId Int     @map("usuario_id")
  rolId     Int     @map("rol_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([usuarioId, rolId])
  @@map("usuarios_roles")
}

model UsuarioSucursal {
  usuarioId      Int      @map("usuario_id")
  sucursalId     Int      @map("sucursal_id")
  predeterminada Boolean  @default(false)
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sucursal       Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  @@id([usuarioId, sucursalId])
  @@map("usuarios_sucursales")
}

model SesionRefresh {
  id        String   @id @default(uuid())
  usuarioId Int      @map("usuario_id")
  tokenHash String   @unique @map("token_hash")
  expiraEn  DateTime @map("expira_en")
  revocado  Boolean  @default(false)
  ip        String?
  userAgent String?  @map("user_agent")
  creadoEn  DateTime @default(now()) @map("creado_en")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sesiones_refresh")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  usuarioId  Int?     @map("usuario_id")
  sucursalId Int?     @map("sucursal_id")
  accion     String // CREAR | ACTUALIZAR | ELIMINAR | ANULAR | LOGIN ...
  entidad    String
  entidadId  String?  @map("entidad_id")
  antes      Json?
  despues    Json?
  ip         String?
  requestId  String?  @map("request_id")
  fecha      DateTime @default(now())

  @@index([entidad, entidadId])
  @@index([fecha])
  @@map("audit_log")
}

// ─────────────────────────────── CATÁLOGOS ──────────────────────────────────

model Pais {
  id            Int            @id @default(autoincrement())
  nombre        String         @unique
  codigoIso     String?        @unique @map("codigo_iso")
  activo        Boolean        @default(true)
  departamentos Departamento[]

  @@map("paises")
}

model Departamento {
  id         Int         @id @default(autoincrement())
  paisId     Int         @map("pais_id")
  nombre     String
  activo     Boolean     @default(true)
  pais       Pais        @relation(fields: [paisId], references: [id])
  municipios Municipio[]

  @@unique([paisId, nombre])
  @@map("departamentos")
}

model Municipio {
  id             Int          @id @default(autoincrement())
  departamentoId Int          @map("departamento_id")
  nombre         String
  activo         Boolean      @default(true)
  departamento   Departamento @relation(fields: [departamentoId], references: [id])
  sucursales     Sucursal[]
  terceros       Tercero[]
  empleados      Empleado[]

  @@unique([departamentoId, nombre])
  @@map("municipios")
}

/// Marca de cabezales, remolques, llantas y repuestos. Permite comparar duración y costo por marca.
model Marca {
  id        Int                    @id @default(autoincrement())
  nombre    String                 @unique
  activo    Boolean                @default(true)
  llantas   Llanta[]
  repuestos Repuesto[]
  usos      OrdenTrabajoRepuesto[]

  @@map("marcas")
}

// ─────────────── TERCEROS (clientes, proveedores, talleres) ─────────────────

enum TipoTercero {
  PERSONA
  EMPRESA
}

/// Cliente (empresa que nos contrata), proveedor (repuestos, llantas, combustible) o taller. Un tercero puede ser varios.
model Tercero {
  id              Int         @id @default(autoincrement())
  tipo            TipoTercero @default(EMPRESA)
  nit             String? // "CF" = consumidor final
  cui             String?
  nombres         String?
  apellidos       String?
  razonSocial     String?     @map("razon_social")
  nombreComercial String?     @map("nombre_comercial")
  email           String?
  telefono        String?
  direccion       String?
  municipioId     Int?        @map("municipio_id")
  contacto        String? // persona de contacto en la empresa
  esCliente       Boolean     @default(true) @map("es_cliente")
  esProveedor     Boolean     @default(false) @map("es_proveedor")
  esTaller        Boolean     @default(false) @map("es_taller")
  limiteCredito   Decimal     @default(0) @map("limite_credito") @db.Decimal(14, 2)
  diasCredito     Int         @default(0) @map("dias_credito")
  activo          Boolean     @default(true)
  legacyId        String?     @unique @map("legacy_id")
  creadoEn        DateTime    @default(now()) @map("creado_en")
  actualizadoEn   DateTime    @updatedAt @map("actualizado_en")

  municipio     Municipio?     @relation(fields: [municipioId], references: [id])
  gastos        Gasto[]
  tarifas       Tarifa[]
  viajes        Viaje[]
  llantas       Llanta[]
  ordenesTaller OrdenTrabajo[]
  cotizaciones  Cotizacion[]

  @@index([nit])
  @@index([cui])
  @@map("terceros")
}

// ─────────────────────────────── RRHH / PILOTOS ─────────────────────────────

model DepartamentoOrg {
  id      Int      @id @default(autoincrement())
  nombre  String   @unique
  activo  Boolean  @default(true)
  puestos Puesto[]

  @@map("rrhh_departamentos")
}

model Puesto {
  id             Int             @id @default(autoincrement())
  departamentoId Int             @map("departamento_id")
  nombre         String
  salarioMinimo  Decimal?        @map("salario_minimo") @db.Decimal(14, 2)
  salarioMaximo  Decimal?        @map("salario_maximo") @db.Decimal(14, 2)
  activo         Boolean         @default(true)
  departamento   DepartamentoOrg @relation(fields: [departamentoId], references: [id])
  empleados      Empleado[]

  @@unique([departamentoId, nombre])
  @@map("rrhh_puestos")
}

enum EstadoEmpleado {
  ACTIVO
  SUSPENDIDO
  BAJA
}

model Empleado {
  id                    Int            @id @default(autoincrement())
  codigo                String         @unique
  nombres               String
  apellidos             String
  cui                   String         @unique
  nit                   String?
  afiliacionIgss        String?        @map("afiliacion_igss")
  fechaNacimiento       DateTime?      @map("fecha_nacimiento") @db.Date
  telefono              String?
  email                 String?
  direccion             String?
  municipioId           Int?           @map("municipio_id")
  sucursalId            Int            @map("sucursal_id")
  puestoId              Int            @map("puesto_id")
  fechaIngreso          DateTime       @map("fecha_ingreso") @db.Date
  fechaBaja             DateTime?      @map("fecha_baja") @db.Date
  motivoBaja            String?        @map("motivo_baja")
  salarioBase           Decimal        @map("salario_base") @db.Decimal(14, 2) // mensual
  bonificacionIncentivo Decimal        @default(250) @map("bonificacion_incentivo") @db.Decimal(14, 2)
  porcentajeComision    Decimal        @default(0) @map("porcentaje_comision") @db.Decimal(5, 2)
  banco                 String?
  cuentaBancaria        String?        @map("cuenta_bancaria")
  estado                EstadoEmpleado @default(ACTIVO)
  creadoEn              DateTime       @default(now()) @map("creado_en")
  actualizadoEn         DateTime       @updatedAt @map("actualizado_en")

  sucursal         Sucursal          @relation(fields: [sucursalId], references: [id])
  puesto           Puesto            @relation(fields: [puestoId], references: [id])
  municipio        Municipio?        @relation(fields: [municipioId], references: [id])
  usuario          Usuario?
  piloto           Piloto?
  asistencias      Asistencia[]
  ausencias        Ausencia[]
  planillaDetalles PlanillaDetalle[]

  @@map("rrhh_empleados")
}

/// Datos de piloto de un empleado: licencia de conducir, pago por viaje y viáticos.
model Piloto {
  id                 Int      @id @default(autoincrement())
  empleadoId         Int      @unique @map("empleado_id")
  licenciaTipo       String   @map("licencia_tipo") // A, B, C, M, E...
  licenciaNumero     String   @map("licencia_numero")
  licenciaVence      DateTime @map("licencia_vence") @db.Date
  tipoSangre         String?  @map("tipo_sangre")
  telefonoEmergencia String?  @map("telefono_emergencia")
  pagoPorViaje       Decimal  @default(0) @map("pago_por_viaje") @db.Decimal(14, 2) // bono fijo por viaje (además del salario)
  viaticoDiario      Decimal  @default(0) @map("viatico_diario") @db.Decimal(14, 2)
  activo             Boolean  @default(true)
  creadoEn           DateTime @default(now()) @map("creado_en")
  actualizadoEn      DateTime @updatedAt @map("actualizado_en")

  empleado     Empleado           @relation(fields: [empleadoId], references: [id])
  cabezales    Cabezal[] // cabezal(es) que tiene asignados
  viajes       Viaje[]
  cargas       CargaCombustible[]
  inspecciones Inspeccion[]

  @@map("pilotos")
}

model Asistencia {
  id            Int       @id @default(autoincrement())
  empleadoId    Int       @map("empleado_id")
  fecha         DateTime  @db.Date
  entrada       DateTime?
  salida        DateTime?
  horasNormales Decimal   @default(0) @map("horas_normales") @db.Decimal(5, 2)
  horasExtra    Decimal   @default(0) @map("horas_extra") @db.Decimal(5, 2)
  origen        String    @default("MANUAL") // MANUAL | BIOMETRICO | APP
  empleado      Empleado  @relation(fields: [empleadoId], references: [id])

  @@unique([empleadoId, fecha])
  @@map("rrhh_asistencias")
}

enum TipoAusencia {
  VACACIONES
  PERMISO_CON_GOCE
  PERMISO_SIN_GOCE
  SUSPENSION_IGSS
  FALTA_INJUSTIFICADA
}

model Ausencia {
  id          Int          @id @default(autoincrement())
  empleadoId  Int          @map("empleado_id")
  tipo        TipoAusencia
  desde       DateTime     @db.Date
  hasta       DateTime     @db.Date
  dias        Decimal      @db.Decimal(5, 2)
  estado      String       @default("SOLICITADA") // SOLICITADA | APROBADA | RECHAZADA
  aprobadaPor Int?         @map("aprobada_por")
  observacion String?
  empleado    Empleado     @relation(fields: [empleadoId], references: [id])

  @@map("rrhh_ausencias")
}

enum EstadoPlanilla {
  BORRADOR
  APROBADA
  PAGADA
  ANULADA
}

model Planilla {
  id              Int               @id @default(autoincrement())
  periodo         String // "2026-10" o "2026-10-Q1"
  tipo            String // MENSUAL | QUINCENAL | AGUINALDO | BONO14
  fechaInicio     DateTime          @map("fecha_inicio") @db.Date
  fechaFin        DateTime          @map("fecha_fin") @db.Date
  estado          EstadoPlanilla    @default(BORRADOR)
  totalDevengado  Decimal           @default(0) @map("total_devengado") @db.Decimal(14, 2)
  totalDescuentos Decimal           @default(0) @map("total_descuentos") @db.Decimal(14, 2)
  totalLiquido    Decimal           @default(0) @map("total_liquido") @db.Decimal(14, 2)
  totalPatronal   Decimal           @default(0) @map("total_patronal") @db.Decimal(14, 2)
  generadaPor     Int               @map("generada_por")
  aprobadaPor     Int?              @map("aprobada_por")
  creadoEn        DateTime          @default(now()) @map("creado_en")
  detalles        PlanillaDetalle[]

  @@unique([periodo, tipo])
  @@map("rrhh_planillas")
}

model PlanillaDetalle {
  id                     Int      @id @default(autoincrement())
  planillaId             Int      @map("planilla_id")
  empleadoId             Int      @map("empleado_id")
  diasLaborados          Decimal  @map("dias_laborados") @db.Decimal(5, 2)
  salarioDevengado       Decimal  @map("salario_devengado") @db.Decimal(14, 2)
  horasExtraMonto        Decimal  @default(0) @map("horas_extra_monto") @db.Decimal(14, 2)
  comisiones             Decimal  @default(0) @db.Decimal(14, 2) // pago por viajes del período
  bonificacionIncentivo  Decimal  @default(0) @map("bonificacion_incentivo") @db.Decimal(14, 2)
  otrosIngresos          Decimal  @default(0) @map("otros_ingresos") @db.Decimal(14, 2)
  totalDevengado         Decimal  @map("total_devengado") @db.Decimal(14, 2)
  igssLaboral            Decimal  @map("igss_laboral") @db.Decimal(14, 2)
  isr                    Decimal  @default(0) @db.Decimal(14, 2)
  otrosDescuentos        Decimal  @default(0) @map("otros_descuentos") @db.Decimal(14, 2)
  totalDescuentos        Decimal  @map("total_descuentos") @db.Decimal(14, 2)
  liquido                Decimal  @db.Decimal(14, 2)
  igssPatronal           Decimal  @map("igss_patronal") @db.Decimal(14, 2)
  irtra                  Decimal  @db.Decimal(14, 2)
  intecap                Decimal  @db.Decimal(14, 2)
  provisionAguinaldo     Decimal  @default(0) @map("provision_aguinaldo") @db.Decimal(14, 2)
  provisionBono14        Decimal  @default(0) @map("provision_bono14") @db.Decimal(14, 2)
  provisionIndemnizacion Decimal  @default(0) @map("provision_indemnizacion") @db.Decimal(14, 2)
  planilla               Planilla @relation(fields: [planillaId], references: [id], onDelete: Cascade)
  empleado               Empleado @relation(fields: [empleadoId], references: [id])

  @@unique([planillaId, empleadoId])
  @@map("rrhh_planillas_detalle")
}

// ─────────────────────────────── ARCHIVOS ───────────────────────────────────

/// Fotos de vales de combustible, recibos de viáticos, pólizas, facturas de taller, logos.
model Archivo {
  id               String              @id @default(uuid())
  nombre           String
  mime             String
  tamano           Int
  datos            Bytes
  publico          Boolean             @default(false) // true: logos/fondos visibles sin sesión (login)
  creadoPorId      Int?                @map("creado_por_id")
  creadoEn         DateTime            @default(now()) @map("creado_en")
  documentos       DocumentoVehiculo[]
  costos           CostoViaje[]
  cargas           CargaCombustible[]
  ordenes          OrdenTrabajo[]
  anticipos        AnticipoViaje[]
  puntosInspeccion InspeccionPunto[]
  evidencias       Evidencia[]

  @@map("archivos")
}

// ─────────────────────────────── FLOTA ──────────────────────────────────────

enum EstadoVehiculo {
  ACTIVO
  EN_TALLER
  INACTIVO
  VENDIDO
}

/// Cabezal (tractocamión). El odómetro se actualiza con cada viaje y carga de combustible.
model Cabezal {
  id                  Int            @id @default(autoincrement())
  codigo              String         @unique // C-01, C-02...
  placa               String         @unique
  marca               String
  modelo              String?
  anio                Int?
  vin                 String?        @unique
  motor               String?
  color               String?
  ejes                Int            @default(3)
  odometro            Decimal        @default(0) @db.Decimal(12, 1) // km
  capacidadTanque     Decimal?       @map("capacidad_tanque") @db.Decimal(8, 2) // galones
  rendimientoEsperado Decimal?       @map("rendimiento_esperado") @db.Decimal(6, 2) // km por galón
  fechaCompra         DateTime?      @map("fecha_compra") @db.Date
  costoCompra         Decimal?       @map("costo_compra") @db.Decimal(14, 2)
  vidaUtilAnios       Int?           @map("vida_util_anios") // para depreciación
  sucursalId          Int            @map("sucursal_id")
  pilotoAsignadoId    Int?           @map("piloto_asignado_id")
  estado              EstadoVehiculo @default(ACTIVO)
  notas               String?
  activo              Boolean        @default(true)
  creadoEn            DateTime       @default(now()) @map("creado_en")
  actualizadoEn       DateTime       @updatedAt @map("actualizado_en")

  sucursal       Sucursal            @relation(fields: [sucursalId], references: [id])
  pilotoAsignado Piloto?             @relation(fields: [pilotoAsignadoId], references: [id])
  documentos     DocumentoVehiculo[]
  viajes         Viaje[]
  cargas         CargaCombustible[]
  montajes       MontajeLlanta[]
  ordenes        OrdenTrabajo[]
  inspecciones   Inspeccion[]
  casos          Caso[]

  @@map("cabezales")
}

/// Remolque: furgón, plataforma, cisterna, portacontenedor...
model Remolque {
  id                 Int            @id @default(autoincrement())
  codigo             String         @unique // R-01...
  placa              String         @unique
  tipo               String // FURGON | PLATAFORMA | CISTERNA | PORTACONTENEDOR | LOWBOY | OTRO
  marca              String?
  anio               Int?
  ejes               Int            @default(2)
  capacidadToneladas Decimal?       @map("capacidad_toneladas") @db.Decimal(8, 2)
  largoMetros        Decimal?       @map("largo_metros") @db.Decimal(6, 2)
  fechaCompra        DateTime?      @map("fecha_compra") @db.Date
  costoCompra        Decimal?       @map("costo_compra") @db.Decimal(14, 2)
  estado             EstadoVehiculo @default(ACTIVO)
  notas              String?
  activo             Boolean        @default(true)
  creadoEn           DateTime       @default(now()) @map("creado_en")
  actualizadoEn      DateTime       @updatedAt @map("actualizado_en")

  documentos   DocumentoVehiculo[]
  viajes       Viaje[]
  montajes     MontajeLlanta[]
  ordenes      OrdenTrabajo[]
  inspecciones Inspeccion[]
  casos        Caso[]

  @@map("remolques")
}

/// Documento con vencimiento de un cabezal o remolque: seguro, tarjeta de circulación, calcomanía, permisos.
model DocumentoVehiculo {
  id         Int       @id @default(autoincrement())
  cabezalId  Int?      @map("cabezal_id")
  remolqueId Int?      @map("remolque_id")
  tipo       String // SEGURO | TARJETA_CIRCULACION | CALCOMANIA | PERMISO_PESO | REVISION | OTRO
  numero     String?
  emisor     String? // aseguradora, SAT, municipalidad...
  emitido    DateTime? @db.Date
  vence      DateTime  @db.Date
  costo      Decimal?  @db.Decimal(14, 2)
  archivoId  String?   @map("archivo_id")
  notas      String?
  activo     Boolean   @default(true)
  creadoEn   DateTime  @default(now()) @map("creado_en")

  cabezal  Cabezal?  @relation(fields: [cabezalId], references: [id])
  remolque Remolque? @relation(fields: [remolqueId], references: [id])
  archivo  Archivo?  @relation(fields: [archivoId], references: [id])

  @@index([vence])
  @@map("documentos_vehiculo")
}

// ─────────────────────────────── VIAJES ─────────────────────────────────────

/// Ruta frecuente con sus kilómetros y peajes estimados (base del cotizador).
model Ruta {
  id              Int         @id @default(autoincrement())
  nombre          String      @unique // "Guatemala - Puerto Quetzal"
  origen          String
  destino         String
  kmEstimados     Decimal     @map("km_estimados") @db.Decimal(12, 1)
  horasEstimadas  Decimal?    @map("horas_estimadas") @db.Decimal(6, 2)
  peajesEstimados Decimal     @default(0) @map("peajes_estimados") @db.Decimal(14, 2)
  viaticoEstimado Decimal     @default(0) @map("viatico_estimado") @db.Decimal(14, 2)
  // Condiciones que encarecen la ruta (el cotizador las convierte en combustible, desgaste y tiempo)
  terreno         TerrenoRuta @default(PLANO)
  subidaMetros    Int?        @map("subida_metros") // ascenso acumulado en el sentido de ida (m)
  trafico         TraficoRuta @default(NORMAL)
  horasEspera     Decimal     @default(0) @map("horas_espera") @db.Decimal(6, 2) // colas en aduana, puerto, planta
  notas           String?
  activo          Boolean     @default(true)
  creadoEn        DateTime    @default(now()) @map("creado_en")
  actualizadoEn   DateTime    @updatedAt @map("actualizado_en")

  tarifas      Tarifa[]
  viajes       Viaje[]
  cotizaciones Cotizacion[]

  @@map("rutas")
}

enum TerrenoRuta {
  PLANO
  ONDULADO
  MONTANA
}

enum TraficoRuta {
  FLUIDO
  NORMAL
  LENTO
  MUY_LENTO
}

enum EstadoCotizacion {
  BORRADOR
  ENVIADA
  ACEPTADA
  RECHAZADA
  CONVERTIDA
}

/// Cotización guardada: el cálculo queda congelado (partidas, supuestos) y se puede convertir en viaje.
model Cotizacion {
  id             Int              @id @default(autoincrement())
  numero         String           @unique // CT-000001
  sucursalId     Int              @map("sucursal_id")
  clienteId      Int?             @map("cliente_id")
  rutaId         Int?             @map("ruta_id")
  origen         String
  destino        String
  kmIda          Decimal          @map("km_ida") @db.Decimal(12, 1)
  regreso        String // VACIO | CARGADO | NINGUNO
  terreno        TerrenoRuta
  trafico        TraficoRuta
  subidaMetros   Int?             @map("subida_metros")
  horasEspera    Decimal          @default(0) @map("horas_espera") @db.Decimal(6, 2)
  extras         Json             @default("[]") // [{ concepto, monto }]
  toneladas      Decimal?         @db.Decimal(8, 2)
  supuestos      Json // rendimiento, precio del galón, costo/km y sus fuentes
  partidas       Json // [{ concepto, monto, detalle }]
  kmTotal        Decimal          @map("km_total") @db.Decimal(12, 1)
  horasEstimadas Decimal?         @map("horas_estimadas") @db.Decimal(6, 1)
  costoTotal     Decimal          @map("costo_total") @db.Decimal(14, 2)
  margen         Decimal          @db.Decimal(6, 2) // % objetivo sobre el costo
  precioSugerido Decimal          @map("precio_sugerido") @db.Decimal(14, 2)
  precioOfrecido Decimal          @map("precio_ofrecido") @db.Decimal(14, 2)
  vigenteHasta   DateTime         @map("vigente_hasta") @db.Date
  estado         EstadoCotizacion @default(BORRADOR)
  notas          String?
  viajeId        Int?             @unique @map("viaje_id")
  creadoPorId    Int              @map("creado_por_id")
  creadoEn       DateTime         @default(now()) @map("creado_en")
  actualizadoEn  DateTime         @updatedAt @map("actualizado_en")

  cliente   Tercero? @relation(fields: [clienteId], references: [id])
  ruta      Ruta?    @relation(fields: [rutaId], references: [id])
  viaje     Viaje?   @relation(fields: [viajeId], references: [id])
  creadoPor Usuario  @relation(fields: [creadoPorId], references: [id])

  @@index([creadoEn])
  @@map("cotizaciones")
}

enum TipoTarifa {
  POR_VIAJE
  POR_KM
  POR_TONELADA
}

/// Lo que se le cobra a cada cliente por ruta (o tarifa general del cliente si no se indica ruta).
model Tarifa {
  id            Int        @id @default(autoincrement())
  clienteId     Int        @map("cliente_id")
  rutaId        Int?       @map("ruta_id")
  descripcion   String?
  tipo          TipoTarifa @default(POR_VIAJE)
  monto         Decimal    @db.Decimal(14, 2)
  vigenteDesde  DateTime   @default(now()) @map("vigente_desde") @db.Date
  vigenteHasta  DateTime?  @map("vigente_hasta") @db.Date
  activo        Boolean    @default(true)
  creadoEn      DateTime   @default(now()) @map("creado_en")
  actualizadoEn DateTime   @updatedAt @map("actualizado_en")

  cliente Tercero @relation(fields: [clienteId], references: [id])
  ruta    Ruta?   @relation(fields: [rutaId], references: [id])
  viajes  Viaje[]

  @@index([clienteId, rutaId])
  @@map("tarifas")
}

enum EstadoViaje {
  PROGRAMADO
  EN_RUTA
  FINALIZADO
  LIQUIDADO
  CANCELADO
}

/// Un viaje = un servicio cobrado a un cliente. Centro de costos y ganancias.
model Viaje {
  id                Int         @id @default(autoincrement())
  numero            String      @unique // V-000001
  sucursalId        Int         @map("sucursal_id")
  clienteId         Int         @map("cliente_id")
  rutaId            Int?        @map("ruta_id")
  tarifaId          Int?        @map("tarifa_id")
  cabezalId         Int         @map("cabezal_id")
  remolqueId        Int?        @map("remolque_id")
  pilotoId          Int         @map("piloto_id")
  origen            String
  destino           String
  carga             String? // descripción de la carga
  toneladas         Decimal?    @db.Decimal(8, 2)
  referencia        String? // orden de servicio, BL, contenedor
  fechaSalida       DateTime    @map("fecha_salida")
  fechaLlegada      DateTime?   @map("fecha_llegada")
  fechaCompromiso   DateTime?   @map("fecha_compromiso") // para entregas a tiempo
  kmSalida          Decimal?    @map("km_salida") @db.Decimal(12, 1)
  kmLlegada         Decimal?    @map("km_llegada") @db.Decimal(12, 1)
  kmVacios          Decimal     @default(0) @map("km_vacios") @db.Decimal(12, 1) // sin carga (deadhead)
  montoCobrado      Decimal     @default(0) @map("monto_cobrado") @db.Decimal(14, 2) // tarifa al cliente
  anticipoPiloto    Decimal     @default(0) @map("anticipo_piloto") @db.Decimal(14, 2)
  pagoPiloto        Decimal     @default(0) @map("pago_piloto") @db.Decimal(14, 2) // bono por viaje
  totalCostos       Decimal     @default(0) @map("total_costos") @db.Decimal(14, 2) // suma de CostoViaje (materializado)
  estado            EstadoViaje @default(PROGRAMADO)
  observaciones     String?
  iniciadoEn        DateTime?   @map("iniciado_en") // salida real (al iniciar)
  motivoCancelacion String?     @map("motivo_cancelacion")
  // Liquidación (foto al cerrar el viaje; no cambia aunque cambien los costos del período)
  liquidadoEn       DateTime?   @map("liquidado_en")
  liquidadoPorId    Int?        @map("liquidado_por_id")
  saldoPiloto       Decimal?    @map("saldo_piloto") @db.Decimal(14, 2) // + el piloto devuelve; − la empresa le paga
  costoKmFijo       Decimal?    @map("costo_km_fijo") @db.Decimal(10, 4) // costo indirecto por km usado al liquidar
  prorrateo         Decimal?    @db.Decimal(14, 2) // km recorridos × costoKmFijo
  ganancia          Decimal?    @db.Decimal(14, 2) // cobrado − costos directos − pago al piloto (+ cargas) − prorrateo
  factorCargas      Decimal?    @map("factor_cargas") @db.Decimal(6, 2) // % de cargas laborales sobre el pago al piloto usado al liquidar
  creadoPorId       Int         @map("creado_por_id")
  creadoEn          DateTime    @default(now()) @map("creado_en")
  actualizadoEn     DateTime    @updatedAt @map("actualizado_en")

  sucursal     Sucursal           @relation(fields: [sucursalId], references: [id])
  cliente      Tercero            @relation(fields: [clienteId], references: [id])
  ruta         Ruta?              @relation(fields: [rutaId], references: [id])
  tarifa       Tarifa?            @relation(fields: [tarifaId], references: [id])
  cabezal      Cabezal            @relation(fields: [cabezalId], references: [id])
  remolque     Remolque?          @relation(fields: [remolqueId], references: [id])
  piloto       Piloto             @relation(fields: [pilotoId], references: [id])
  creadoPor    Usuario            @relation("ViajeCreadoPor", fields: [creadoPorId], references: [id])
  liquidadoPor Usuario?           @relation("ViajeLiquidadoPor", fields: [liquidadoPorId], references: [id])
  costos       CostoViaje[]
  cargas       CargaCombustible[]
  gastos       Gasto[]
  anticipos    AnticipoViaje[]
  inspecciones Inspeccion[]
  casos        Caso[]
  cotizacion   Cotizacion?
  eventos      EventoViaje[]

  @@index([fechaSalida])
  @@index([cabezalId, fechaSalida])
  @@index([pilotoId, fechaSalida])
  @@index([clienteId, fechaSalida])
  @@index([estado])
  @@map("viajes")
}

enum TipoCostoViaje {
  COMBUSTIBLE
  PEAJE
  VIATICO
  HORAS_EXTRA
  PARQUEO
  CARGA_DESCARGA
  MULTA
  REPARACION_EN_RUTA
  OTRO
}

/// Costo directo de un viaje (lo que se liquida contra el anticipo del piloto).
model CostoViaje {
  id              Int            @id @default(autoincrement())
  viajeId         Int            @map("viaje_id")
  tipo            TipoCostoViaje
  descripcion     String?
  monto           Decimal        @db.Decimal(14, 2)
  fecha           DateTime       @default(now())
  pagadoPorPiloto Boolean        @default(true) @map("pagado_por_piloto") // true: salió del anticipo; false: lo pagó la empresa (crédito, tarjeta)
  documento       String? // factura o recibo
  cargaId         Int?           @unique @map("carga_id") // si nace de una carga de combustible
  archivoId       String?        @map("archivo_id") // foto del recibo
  registradoPorId Int            @map("registrado_por_id")
  creadoEn        DateTime       @default(now()) @map("creado_en")

  viaje         Viaje             @relation(fields: [viajeId], references: [id], onDelete: Cascade)
  carga         CargaCombustible? @relation(fields: [cargaId], references: [id])
  archivo       Archivo?          @relation(fields: [archivoId], references: [id])
  registradoPor Usuario           @relation(fields: [registradoPorId], references: [id])

  @@index([viajeId])
  @@map("costos_viaje")
}

/// Efectivo que se entrega al piloto para el viaje (peajes, comidas, imprevistos). Se liquida contra los costos que pagó.
model AnticipoViaje {
  id             Int        @id @default(autoincrement())
  viajeId        Int        @map("viaje_id")
  monto          Decimal    @db.Decimal(14, 2)
  medio          MedioGasto @default(EFECTIVO)
  fecha          DateTime   @default(now())
  nota           String?
  archivoId      String?    @map("archivo_id") // foto del vale firmado
  entregadoPorId Int        @map("entregado_por_id")
  creadoEn       DateTime   @default(now()) @map("creado_en")

  viaje        Viaje    @relation(fields: [viajeId], references: [id], onDelete: Cascade)
  archivo      Archivo? @relation(fields: [archivoId], references: [id])
  entregadoPor Usuario  @relation(fields: [entregadoPorId], references: [id])

  @@index([viajeId])
  @@map("anticipos_viaje")
}

// ─────────────────────────────── COMBUSTIBLE ────────────────────────────────

/// Carga de combustible. Con tanque lleno a tanque lleno se calcula el rendimiento real (km/gal).
model CargaCombustible {
  id              Int      @id @default(autoincrement())
  sucursalId      Int      @map("sucursal_id")
  cabezalId       Int      @map("cabezal_id")
  pilotoId        Int?     @map("piloto_id")
  viajeId         Int?     @map("viaje_id")
  fecha           DateTime @default(now())
  odometro        Decimal  @db.Decimal(12, 1)
  galones         Decimal  @db.Decimal(10, 3)
  precioGalon     Decimal  @map("precio_galon") @db.Decimal(10, 4)
  total           Decimal  @db.Decimal(14, 2)
  tanqueLleno     Boolean  @default(true) @map("tanque_lleno")
  estacion        String?
  documento       String? // número de factura o vale
  archivoId       String?  @map("archivo_id") // foto del vale
  pagadoPorPiloto Boolean  @default(false) @map("pagado_por_piloto") // con el anticipo del viaje
  // Rendimiento tanque lleno a tanque lleno (se calcula al registrar)
  kmRecorridos    Decimal? @map("km_recorridos") @db.Decimal(12, 1)
  galonesTramo    Decimal? @map("galones_tramo") @db.Decimal(10, 3)
  rendimiento     Decimal? @db.Decimal(8, 3) // km por galón
  alerta          Boolean  @default(false) // rendimiento por debajo del esperado
  anulada         Boolean  @default(false)
  motivoAnulacion String?  @map("motivo_anulacion")
  registradoPorId Int      @map("registrado_por_id")
  creadoEn        DateTime @default(now()) @map("creado_en")

  sucursal      Sucursal    @relation(fields: [sucursalId], references: [id])
  cabezal       Cabezal     @relation(fields: [cabezalId], references: [id])
  piloto        Piloto?     @relation(fields: [pilotoId], references: [id])
  viaje         Viaje?      @relation(fields: [viajeId], references: [id])
  archivo       Archivo?    @relation(fields: [archivoId], references: [id])
  registradoPor Usuario     @relation(fields: [registradoPorId], references: [id])
  costo         CostoViaje?

  @@index([cabezalId, fecha])
  @@index([cabezalId, odometro])
  @@index([fecha])
  @@map("cargas_combustible")
}

// ─────────────────────────────── INSPECCIÓN PRE VIAJE ───────────────────────

enum ResultadoInspeccion {
  APROBADA // todo bien
  CON_OBSERVACIONES // fallas menores: puede salir, se abre orden de trabajo
  RECHAZADA // falla crítica (frenos, llantas, luces…): no puede salir
}

enum EstadoPunto {
  OK
  FALLA
  NO_APLICA
}

/// Revisión diaria del piloto antes de salir (DVIR). Una falla abre una orden de trabajo correctiva sola.
model Inspeccion {
  id              Int                 @id @default(autoincrement())
  sucursalId      Int                 @map("sucursal_id")
  cabezalId       Int                 @map("cabezal_id")
  remolqueId      Int?                @map("remolque_id")
  pilotoId        Int?                @map("piloto_id")
  viajeId         Int?                @map("viaje_id")
  fecha           DateTime            @default(now())
  odometro        Decimal?            @db.Decimal(12, 1)
  resultado       ResultadoInspeccion
  fallas          Int                 @default(0)
  fallasCriticas  Int                 @default(0) @map("fallas_criticas")
  observaciones   String?
  ordenTrabajoId  Int?                @unique @map("orden_trabajo_id")
  registradoPorId Int                 @map("registrado_por_id")
  creadoEn        DateTime            @default(now()) @map("creado_en")

  sucursal      Sucursal          @relation(fields: [sucursalId], references: [id])
  cabezal       Cabezal           @relation(fields: [cabezalId], references: [id])
  remolque      Remolque?         @relation(fields: [remolqueId], references: [id])
  piloto        Piloto?           @relation(fields: [pilotoId], references: [id])
  viaje         Viaje?            @relation(fields: [viajeId], references: [id])
  ordenTrabajo  OrdenTrabajo?     @relation(fields: [ordenTrabajoId], references: [id])
  registradoPor Usuario           @relation(fields: [registradoPorId], references: [id])
  puntos        InspeccionPunto[]
  casos         Caso[]
  evidencias    Evidencia[]

  @@index([cabezalId, fecha])
  @@index([fecha])
  @@map("inspecciones")
}

model InspeccionPunto {
  id           Int         @id @default(autoincrement())
  inspeccionId Int         @map("inspeccion_id")
  codigo       String // FRENOS, LUCES, LLANTAS... (catálogo en código: inspecciones.logica.ts)
  estado       EstadoPunto
  critico      Boolean     @default(false) // foto del catálogo al momento de la inspección
  nota         String?
  archivoId    String?     @map("archivo_id")

  inspeccion Inspeccion @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  archivo    Archivo?   @relation(fields: [archivoId], references: [id])

  @@unique([inspeccionId, codigo])
  @@map("inspecciones_puntos")
}

// ─────────────────────────────── LLANTAS ────────────────────────────────────

enum EstadoLlanta {
  EN_BODEGA
  MONTADA
  EN_REENCAUCHE
  DESECHADA
}

/// Cada llanta se sigue por su serie (DOT): dónde estuvo montada, cuántos km dio y cuánto costó por km.
model Llanta {
  id            Int          @id @default(autoincrement())
  codigo        String       @unique // serie / DOT / número interno
  marcaId       Int?         @map("marca_id")
  modelo        String?
  medida        String // 11R22.5, 295/80R22.5...
  precio        Decimal      @db.Decimal(14, 2)
  fechaCompra   DateTime?    @map("fecha_compra") @db.Date
  proveedorId   Int?         @map("proveedor_id")
  reencauches   Int          @default(0)
  kmAcumulados  Decimal      @default(0) @map("km_acumulados") @db.Decimal(12, 1)
  estado        EstadoLlanta @default(EN_BODEGA)
  motivoBaja    String?      @map("motivo_baja")
  activo        Boolean      @default(true)
  creadoEn      DateTime     @default(now()) @map("creado_en")
  actualizadoEn DateTime     @updatedAt @map("actualizado_en")

  marca     Marca?          @relation(fields: [marcaId], references: [id])
  proveedor Tercero?        @relation(fields: [proveedorId], references: [id])
  montajes  MontajeLlanta[]

  @@map("llantas")
}

/// Montaje de una llanta en una posición de un cabezal o remolque (eje y lado).
model MontajeLlanta {
  id            Int       @id @default(autoincrement())
  llantaId      Int       @map("llanta_id")
  cabezalId     Int?      @map("cabezal_id")
  remolqueId    Int?      @map("remolque_id")
  posicion      String // "E1-I", "E2-DE" (eje, lado, interna/externa)
  fechaMontaje  DateTime  @map("fecha_montaje") @db.Date
  kmMontaje     Decimal   @map("km_montaje") @db.Decimal(12, 1)
  fechaRetiro   DateTime? @map("fecha_retiro") @db.Date
  kmRetiro      Decimal?  @map("km_retiro") @db.Decimal(12, 1)
  profundidadMm Decimal?  @map("profundidad_mm") @db.Decimal(5, 2) // al retirar o en inspección
  motivoRetiro  String?   @map("motivo_retiro")
  creadoEn      DateTime  @default(now()) @map("creado_en")

  llanta   Llanta    @relation(fields: [llantaId], references: [id])
  cabezal  Cabezal?  @relation(fields: [cabezalId], references: [id])
  remolque Remolque? @relation(fields: [remolqueId], references: [id])

  @@index([llantaId])
  @@index([cabezalId, fechaRetiro])
  @@map("montajes_llanta")
}

// ─────────────────────────────── MANTENIMIENTO ──────────────────────────────

/// Plan preventivo: cada X km o Y días (lo que ocurra primero).
model PlanMantenimiento {
  id          Int            @id @default(autoincrement())
  nombre      String         @unique // "Cambio de aceite", "Servicio mayor"
  descripcion String?
  aplicaA     String         @default("CABEZAL") @map("aplica_a") // CABEZAL | REMOLQUE | AMBOS
  cadaKm      Int?           @map("cada_km")
  cadaDias    Int?           @map("cada_dias")
  avisoKm     Int            @default(1000) @map("aviso_km") // avisar con esta anticipación
  avisoDias   Int            @default(15) @map("aviso_dias")
  activo      Boolean        @default(true)
  ordenes     OrdenTrabajo[]

  @@map("planes_mantenimiento")
}

/// Repuesto o insumo que se usa en el taller (filtro, aceite, balatas...).
model Repuesto {
  id               Int      @id @default(autoincrement())
  codigo           String   @unique
  nombre           String
  categoria        String? // FILTROS | LUBRICANTES | FRENOS | SUSPENSION | ELECTRICO | MOTOR | OTRO
  marcaId          Int?     @map("marca_id")
  unidad           String   @default("UNIDAD")
  precioReferencia Decimal? @map("precio_referencia") @db.Decimal(14, 2)
  activo           Boolean  @default(true)

  marca Marca?                 @relation(fields: [marcaId], references: [id])
  usos  OrdenTrabajoRepuesto[]

  @@map("repuestos")
}

enum TipoOrdenTrabajo {
  PREVENTIVO
  SERVICIO_MAYOR
  CORRECTIVO
  LLANTAS
  CARROCERIA
}

enum EstadoOrdenTrabajo {
  ABIERTA
  EN_PROCESO
  CERRADA
  ANULADA
}

/// Orden de trabajo de taller (propio o externo): mano de obra + repuestos.
model OrdenTrabajo {
  id             Int                @id @default(autoincrement())
  numero         String             @unique // OT-000001
  sucursalId     Int                @map("sucursal_id")
  cabezalId      Int?               @map("cabezal_id")
  remolqueId     Int?               @map("remolque_id")
  planId         Int?               @map("plan_id")
  tallerId       Int?               @map("taller_id") // null = taller propio
  tipo           TipoOrdenTrabajo
  prioridad      PrioridadCaso      @default(MODERADA)
  descripcion    String
  odometro       Decimal?           @db.Decimal(12, 1)
  fechaApertura  DateTime           @default(now()) @map("fecha_apertura")
  fechaCierre    DateTime?          @map("fecha_cierre")
  manoObra       Decimal            @default(0) @map("mano_obra") @db.Decimal(14, 2)
  totalRepuestos Decimal            @default(0) @map("total_repuestos") @db.Decimal(14, 2)
  total          Decimal            @default(0) @db.Decimal(14, 2)
  documento      String? // factura del taller
  archivoId      String?            @map("archivo_id")
  estado         EstadoOrdenTrabajo @default(ABIERTA)
  observaciones  String?
  creadoPorId    Int                @map("creado_por_id")
  creadoEn       DateTime           @default(now()) @map("creado_en")
  actualizadoEn  DateTime           @updatedAt @map("actualizado_en")

  sucursal   Sucursal               @relation(fields: [sucursalId], references: [id])
  cabezal    Cabezal?               @relation(fields: [cabezalId], references: [id])
  remolque   Remolque?              @relation(fields: [remolqueId], references: [id])
  plan       PlanMantenimiento?     @relation(fields: [planId], references: [id])
  taller     Tercero?               @relation(fields: [tallerId], references: [id])
  archivo    Archivo?               @relation(fields: [archivoId], references: [id])
  creadoPor  Usuario                @relation(fields: [creadoPorId], references: [id])
  repuestos  OrdenTrabajoRepuesto[]
  inspeccion Inspeccion?
  casos      Caso[]

  @@index([cabezalId, fechaApertura])
  @@index([fechaApertura])
  @@map("ordenes_trabajo")
}

model OrdenTrabajoRepuesto {
  id            Int     @id @default(autoincrement())
  ordenId       Int     @map("orden_id")
  repuestoId    Int     @map("repuesto_id")
  marcaId       Int?    @map("marca_id") // marca realmente usada (para comparar marcas)
  cantidad      Decimal @default(1) @db.Decimal(10, 2)
  costoUnitario Decimal @map("costo_unitario") @db.Decimal(14, 2)
  total         Decimal @db.Decimal(14, 2)

  orden    OrdenTrabajo @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  repuesto Repuesto     @relation(fields: [repuestoId], references: [id])
  marca    Marca?       @relation(fields: [marcaId], references: [id])

  @@index([ordenId])
  @@map("ordenes_trabajo_repuestos")
}

// ─────────────────────────────── CASOS ──────────────────────────────────────

enum PrioridadCaso {
  URGENTE // atender de inmediato (plazo por parámetro, 4 h)
  ALTA // hoy (24 h)
  MODERADA // esta semana (72 h)
  BAJA // cuando se pueda (7 días)
}

enum EstadoCaso {
  ABIERTO
  EN_PROCESO
  RESUELTO
  ANULADO
}

/// Caso o requerimiento: algo que hay que atender (hallazgo de una inspección, un reporte del piloto, un pendiente).
/// Tiene prioridad, plazo de atención, responsable y su historial de seguimiento.
model Caso {
  id             Int           @id @default(autoincrement())
  numero         String        @unique // CS-000001
  sucursalId     Int           @map("sucursal_id")
  origen         String // INSPECCION | VIAJE | MANUAL
  tipo           String // MECANICO | LLANTAS | DOCUMENTOS | SEGURIDAD | CARGA | OTRO
  prioridad      PrioridadCaso
  estado         EstadoCaso    @default(ABIERTO)
  titulo         String
  descripcion    String?
  impideSalir    Boolean       @default(false) @map("impide_salir")
  latitud        Decimal?      @db.Decimal(9, 6) // dónde se reportó (móvil)
  longitud       Decimal?      @db.Decimal(9, 6)
  uuidCliente    String?       @unique @map("uuid_cliente") // id generado en el móvil: reenviar sin conexión no duplica
  cabezalId      Int?          @map("cabezal_id")
  remolqueId     Int?          @map("remolque_id")
  viajeId        Int?          @map("viaje_id")
  inspeccionId   Int?          @map("inspeccion_id")
  puntoCodigo    String?       @map("punto_codigo") // punto de la lista de revisión que lo originó
  ordenTrabajoId Int?          @map("orden_trabajo_id")
  responsableId  Int?          @map("responsable_id")
  venceEn        DateTime      @map("vence_en") // plazo de atención según la prioridad
  resueltoEn     DateTime?     @map("resuelto_en")
  resolucion     String?
  creadoPorId    Int           @map("creado_por_id")
  creadoEn       DateTime      @default(now()) @map("creado_en")
  actualizadoEn  DateTime      @updatedAt @map("actualizado_en")

  sucursal     Sucursal      @relation(fields: [sucursalId], references: [id])
  cabezal      Cabezal?      @relation(fields: [cabezalId], references: [id])
  remolque     Remolque?     @relation(fields: [remolqueId], references: [id])
  viaje        Viaje?        @relation(fields: [viajeId], references: [id])
  inspeccion   Inspeccion?   @relation(fields: [inspeccionId], references: [id])
  ordenTrabajo OrdenTrabajo? @relation(fields: [ordenTrabajoId], references: [id])
  responsable  Usuario?      @relation("CasoResponsable", fields: [responsableId], references: [id])
  creadoPor    Usuario       @relation("CasoCreadoPor", fields: [creadoPorId], references: [id])
  notas        CasoNota[]
  evidencias   Evidencia[]
  eventos      EventoViaje[]

  @@index([estado, venceEn])
  @@index([cabezalId, estado])
  @@map("casos")
}

/// Seguimiento de un caso: comentarios y cambios de estado o prioridad.
model CasoNota {
  id        Int      @id @default(autoincrement())
  casoId    Int      @map("caso_id")
  usuarioId Int      @map("usuario_id")
  cambio    String? // "ABIERTO → EN_PROCESO", "MODERADA → URGENTE"
  texto     String?
  creadoEn  DateTime @default(now()) @map("creado_en")

  caso    Caso    @relation(fields: [casoId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([casoId])
  @@map("casos_notas")
}

// ─────────────────────────────── REPORTE EN VIVO ────────────────────────────

enum TipoEventoViaje {
  SALIDA
  LLEGADA_CARGA // llegó al punto de carga
  CARGANDO
  EN_RUTA
  EN_COLA // aduana, puerto, planta
  ADUANA
  PARADA // comida, descanso, combustible
  LLEGADA_DESTINO
  DESCARGANDO
  ENTREGADO
  INCIDENTE // falla, accidente, retén, robo, clima
  NOTA
}

/// Bitácora en vivo del viaje: lo que el piloto reporta desde el camino, con hora, ubicación y fotos.
model EventoViaje {
  id              Int             @id @default(autoincrement())
  viajeId         Int             @map("viaje_id")
  tipo            TipoEventoViaje
  texto           String?
  latitud         Decimal?        @db.Decimal(9, 6)
  longitud        Decimal?        @db.Decimal(9, 6)
  precisionM      Int?            @map("precision_m")
  odometro        Decimal?        @db.Decimal(12, 1)
  ocurridoEn      DateTime        @map("ocurrido_en") // hora del celular (puede llegar después, sin señal)
  recibidoEn      DateTime        @default(now()) @map("recibido_en")
  uuidCliente     String?         @unique @map("uuid_cliente")
  casoId          Int?            @map("caso_id") // un incidente puede abrir un caso
  registradoPorId Int             @map("registrado_por_id")

  viaje         Viaje       @relation(fields: [viajeId], references: [id], onDelete: Cascade)
  caso          Caso?       @relation(fields: [casoId], references: [id])
  registradoPor Usuario     @relation(fields: [registradoPorId], references: [id])
  evidencias    Evidencia[]

  @@index([viajeId, ocurridoEn])
  @@index([recibidoEn])
  @@map("eventos_viaje")
}

/// Foto (o PDF) de evidencia de un evento del viaje, un caso o una inspección, con dónde y cuándo se tomó.
model Evidencia {
  id            Int       @id @default(autoincrement())
  archivoId     String    @map("archivo_id")
  eventoViajeId Int?      @map("evento_viaje_id")
  casoId        Int?      @map("caso_id")
  inspeccionId  Int?      @map("inspeccion_id")
  descripcion   String?
  latitud       Decimal?  @db.Decimal(9, 6)
  longitud      Decimal?  @db.Decimal(9, 6)
  tomadaEn      DateTime? @map("tomada_en")
  creadoPorId   Int       @map("creado_por_id")
  creadoEn      DateTime  @default(now()) @map("creado_en")

  archivo     Archivo      @relation(fields: [archivoId], references: [id])
  eventoViaje EventoViaje? @relation(fields: [eventoViajeId], references: [id], onDelete: Cascade)
  caso        Caso?        @relation(fields: [casoId], references: [id], onDelete: Cascade)
  inspeccion  Inspeccion?  @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  creadoPor   Usuario      @relation(fields: [creadoPorId], references: [id])

  @@index([eventoViajeId])
  @@index([casoId])
  @@index([inspeccionId])
  @@map("evidencias")
}

// ─────────────────────────────── GASTOS ─────────────────────────────────────

enum MedioGasto {
  TRANSFERENCIA
  TARJETA
  CHEQUE
  DEBITO
  EFECTIVO
}

enum EstadoGasto {
  REGISTRADO
  ANULADO
}

model CategoriaGasto {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  activo Boolean @default(true)
  gastos Gasto[]

  @@map("categorias_gasto")
}

/// Gasto de operación (alquiler del predio, seguros, salarios administrativos, servicios…). Se prorratea por km.
model Gasto {
  id              Int            @id @default(autoincrement())
  sucursalId      Int            @map("sucursal_id")
  categoriaId     Int            @map("categoria_id")
  viajeId         Int?           @map("viaje_id") // si es atribuible a un viaje
  fecha           DateTime       @db.Date
  concepto        String
  monto           Decimal        @db.Decimal(14, 2)
  medioPago       MedioGasto     @map("medio_pago")
  proveedorId     Int?           @map("proveedor_id")
  documento       String? // factura, recibo o referencia de la transferencia
  estado          EstadoGasto    @default(REGISTRADO)
  motivoAnulacion String?        @map("motivo_anulacion")
  usuarioId       Int            @map("usuario_id")
  creadoEn        DateTime       @default(now()) @map("creado_en")
  sucursal        Sucursal       @relation(fields: [sucursalId], references: [id])
  categoria       CategoriaGasto @relation(fields: [categoriaId], references: [id])
  viaje           Viaje?         @relation(fields: [viajeId], references: [id])
  proveedor       Tercero?       @relation(fields: [proveedorId], references: [id])
  usuario         Usuario        @relation(fields: [usuarioId], references: [id])

  @@index([fecha])
  @@index([sucursalId, fecha])
  @@map("gastos")
}

// ─────────────────────────────── NOTIFICACIONES ─────────────────────────────

/// Hechos que se avisan en la campana (p. ej. "viaje liquidado"): se muestran durante 7 días.
model EventoNotificacion {
  id         Int      @id @default(autoincrement())
  sucursalId Int?     @map("sucursal_id") // null = todas las sedes
  permiso    String // solo lo ven quienes tienen este permiso
  tipo       String
  nivel      String   @default("info")
  titulo     String
  detalle    String
  ruta       String?
  creadoEn   DateTime @default(now()) @map("creado_en")

  @@index([creadoEn])
  @@map("eventos_notificacion")
}

/// Qué notificaciones ya vio cada usuario (las vistas siguen en la lista, abajo y en gris).
model NotificacionVista {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  clave     String
  vistoEn   DateTime @default(now()) @map("visto_en")

  @@unique([usuarioId, clave])
  @@index([vistoEn])
  @@map("notificaciones_vistas")
}

// ─────────────────────────────── CENTRAL ────────────────────────────────────

/// Uso diario anónimo que se reporta a Central (si hay consentimiento).
model UsoDiario {
  id          Int      @id @default(autoincrement())
  fecha       DateTime @db.Date
  evento      String
  rol         String
  dispositivo String
  veces       Int      @default(0)
  enviado     Boolean  @default(false)

  @@unique([fecha, evento, rol, dispositivo])
  @@index([enviado, fecha])
  @@map("uso_diario")
}

/// Opiniones que los usuarios envían a ALEXUS: recomendación (0 a 10), "¿le sirvió?" y sugerencias.
model Opinion {
  id       Int      @id @default(autoincrement())
  tipo     String // NPS | UTIL | SUGERENCIA
  puntaje  Int?
  texto    String?
  pantalla String?
  contacto String?
  rol      String?
  creadoEn DateTime @default(now()) @map("creado_en")
  enviado  Boolean  @default(false)

  @@index([enviado])
  @@index([tipo, creadoEn])
  @@map("opiniones")
}
