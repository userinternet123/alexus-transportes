# ── Servidor ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Orígenes permitidos (CORS), separados por coma. Ej: el portal React (Vite)
CORS_ORIGINS=http://localhost:5173

# ── Base de datos ────────────────────────────────────────
DATABASE_URL=postgresql://spvi:spvi_dev_pwd@localhost:5432/spvi?schema=public

# ── Seguridad ────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambiar-por-secreto-largo-aleatorio
JWT_ACCESS_TTL_SEG=900
REFRESH_TTL_DAYS=7
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15

# ── Zona horaria del negocio (define la "fecha contable") ─
TZ_NEGOCIO=America/Guatemala

# ── FEL (Factura Electrónica en Línea - SAT) ─────────────
# mock | infile | digifact | ... (implementar adaptador del certificador contratado)
FEL_PROVEEDOR=mock
FEL_URL=
FEL_USUARIO=
FEL_LLAVE=
