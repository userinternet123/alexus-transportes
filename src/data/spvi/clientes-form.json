[
  {
    "subgrupo": "Información de clientes",
    "icon": "user",
    "description": "Los campos marcados con * son obligatorios",
    "dataField": "clientes",
    "type": "table",
    "defaultOpen": true,
    "className": "mb-4",
    "fields": [
      {
        "name": "id",
        "label": "Código",
        "size": "small",
        "readOnly": true,
        "placeholder": "Se genera automáticamente"
      },
      {
        "name": "tipo",
        "label": "Tipo",
        "type": "radio",
        "size": "supersmall",
        "options": [
          {
            "value": "PERSONA",
            "label": "Persona",
            "default": true
          },
          {
            "value": "EMPRESA",
            "label": "Empresa"
          }
        ]
      },
      {
        "name": "nit",
        "label": "NIT",
        "type": "text",
        "size": "small",
        "placeholder": "Ingrese nit",
        "required": true,
        "formato": "nit"
      },
      {
        "name": "cui",
        "label": "CUI / DPI",
        "type": "text",
        "size": "small",
        "placeholder": "Ingrese cui / dpi",
        "mask": "dpi"
      },
      {
        "name": "nombres",
        "label": "Nombres",
        "type": "text",
        "size": "medium",
        "placeholder": "Ingrese nombres",
        "visibleWhen": {
          "name": "tipo",
          "value": "PERSONA",
          "showDefault": true
        }
      },
      {
        "name": "apellidos",
        "label": "Apellidos",
        "type": "text",
        "size": "medium",
        "placeholder": "Ingrese apellidos",
        "visibleWhen": {
          "name": "tipo",
          "value": "PERSONA",
          "showDefault": true
        }
      },
      {
        "name": "razonSocial",
        "label": "Razón social",
        "type": "text",
        "size": "full",
        "placeholder": "Ingrese razón social",
        "visibleWhen": {
          "name": "tipo",
          "value": "EMPRESA"
        }
      },
      {
        "name": "telefono",
        "label": "Teléfono",
        "type": "text",
        "size": "small",
        "placeholder": "Ingrese teléfono",
        "mask": "phone"
      },
      {
        "name": "email",
        "label": "Correo",
        "type": "text",
        "size": "medium",
        "placeholder": "Ingrese correo"
      },
      {
        "name": "direccion",
        "label": "Dirección",
        "type": "text",
        "size": "full",
        "placeholder": "Ingrese dirección"
      },
      {
        "name": "limiteCredito",
        "label": "Límite de crédito",
        "type": "money",
        "size": "small",
        "mask": "money"
      },
      {
        "name": "diasCredito",
        "label": "Días de crédito",
        "type": "number",
        "size": "small",
        "mask": "number"
      }
    ]
  }
]