[
  {
    "subgrupo": "Información de productos",
    "icon": "clipboardList",
    "description": "Los campos marcados con * son obligatorios",
    "dataField": "productos",
    "type": "table",
    "defaultOpen": true,
    "className": "mb-4",
    "fields": [
      {
        "name": "id",
        "label": "Código",
        "size": "small",
        "readOnly": true,
        "placeholder": "Se genera automáticamente"
      },
      {
        "name": "sku",
        "label": "SKU",
        "type": "text",
        "size": "small",
        "placeholder": "Ingrese sku",
        "required": true
      },
      {
        "name": "codigoBarra",
        "label": "Código de barras",
        "type": "text",
        "size": "medium",
        "placeholder": "Ingrese código de barras",
        "keyDown": null
      },
      {
        "name": "nombre",
        "label": "Nombre",
        "type": "text",
        "size": "full",
        "placeholder": "Ingrese nombre",
        "required": true
      },
      {
        "name": "descripcion",
        "label": "Descripción",
        "type": "text",
        "size": "full",
        "placeholder": "Ingrese descripción"
      },
      {
        "name": "subgrupoId",
        "label": "Sub-agrupación",
        "type": "select",
        "size": "medium",
        "optionsUrl": "/catalogos/subgrupos",
        "columnaDb": {
          "codigo": "id",
          "nombre": "nombre"
        },
        "required": true
      },
      {
        "name": "marcaId",
        "label": "Marca",
        "type": "select",
        "size": "medium",
        "optionsUrl": "/catalogos/marcas",
        "columnaDb": {
          "codigo": "id",
          "nombre": "nombre"
        }
      },
      {
        "name": "presentacionId",
        "label": "Presentación",
        "type": "select",
        "size": "medium",
        "optionsUrl": "/catalogos/presentaciones",
        "columnaDb": {
          "codigo": "id",
          "nombre": "nombre"
        },
        "required": true
      },
      {
        "name": "precioVenta",
        "label": "Precio de venta (IVA incl.)",
        "type": "money",
        "size": "small",
        "mask": "money",
        "required": true
      },
      {
        "name": "stockMinimo",
        "label": "Stock mínimo",
        "type": "number",
        "size": "small",
        "mask": "number"
      },
      {
        "name": "manejaInventario",
        "label": "Controla existencias",
        "type": "checkbox",
        "size": "small"
      },
      {
        "name": "exentoIva",
        "label": "Exento de IVA",
        "type": "checkbox",
        "size": "small"
      }
    ]
  }
]
