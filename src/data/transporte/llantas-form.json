    "type": "table",
    "defaultOpen": true,
    "className": "mb-4",
    "fields": [
      {
        "name": "id",
        "label": "Código",
        "size": "small",
        "readOnly": true,
        "placeholder": "Se genera automáticamente"
      },
      {
        "name": "codigo",
        "label": "Serie / DOT / número interno",
