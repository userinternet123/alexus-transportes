        "type": "number",
        "size": "small",
        "mask": "number"
      },
      {
        "name": "estado",
        "label": "Situación",
        "type": "select",
        "size": "small",
        "options": [
          {
            "value": "EN_BODEGA",
            "label": "En bodega"
          },
          {
            "value": "MONTADA",
            "label": "Montada"
          },
          {
            "value": "EN_REENCAUCHE",
            "label": "En reencauche"
          },
          {
            "value": "DESECHADA",
            "label": "Desechada"
          }
        ]
      }
    ]
  }
