        "size": "medium",
        "placeholder": "Ingrese serie / dot / número interno",
        "required": true
      },
      {
        "name": "marcaId",
        "label": "Marca",
        "type": "select",
        "size": "medium",
        "optionsUrl": "/catalogos/marcas",
        "columnaDb": {
          "codigo": "id",
          "nombre": "nombre"
        }
      },
      {
        "name": "modelo",
        "label": "Modelo",
        "type": "text",
        "size": "medium",
        "placeholder": "Ingrese modelo"
      },
      {
        "name": "medida",
        "label": "Medida",
        "type": "text",
        "size": "small",
        "placeholder": "11R22.5",
        "required": true
      },
      {
        "name": "precio",
        "label": "Precio",
        "type": "money",
        "size": "small",
        "mask": "money",
        "required": true
      },
      {
        "name": "fechaCompra",
        "label": "Fecha de compra",
        "type": "date",
        "size": "small"
      },
      {
        "name": "proveedorId",
        "label": "Proveedor",
        "type": "select",
        "size": "medium",
        "optionsUrl": "/terceros/proveedores",
