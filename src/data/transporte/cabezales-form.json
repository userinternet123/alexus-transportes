[
  {
    "subgrupo": "Información de cabezales",
    "icon": "truck",
    "description": "Los campos marcados con * son obligatorios",
    "dataField": "cabezales",
    "type": "table",
    "defaultOpen": true,
    "className": "mb-4",
    "fields": [
      {
        "name": "id",
        "label": "Código",
        "size": "small",
        "readOnly": true,
        "placeholder": "Se genera automáticamente"
      },
      {
        "name": "codigo",
        "label": "Código interno",
        "type": "text",
        "size": "small",
        "placeholder": "C-01",
        "required": true
      },
      {
        "name": "placa",
        "label": "Placa",
        "type": "text",
        "size": "small",
        "placeholder": "C123BCD",
        "required": true
      },
      {
        "name": "marca",
        "label": "Marca",
        "type": "text",
        "size": "medium",
        "placeholder": "Freightliner, Kenworth, International…",
        "required": true
      },
      {
        "name": "modelo",
        "label": "Modelo",
        "type": "text",
        "size": "medium",
        "placeholder": "Ingrese modelo"
      },
      {
        "name": "anio",
        "label": "Año",
        "type": "number",
        "size": "small",
        "mask": "number"
      },
      {
        "name": "vin",
        "label": "VIN / chasis",
        "type": "text",
        "size": "medium",
        "placeholder": "Ingrese vin / chasis"
      },
      {
        "name": "motor",
        "label": "Motor",
        "type": "text",
        "size": "medium",
        "placeholder": "Ingrese motor"
      },
      {
        "name": "color",
        "label": "Color",
        "type": "text",
        "size": "small",
        "placeholder": "Ingrese color"
      },
      {
        "name": "ejes",
        "label": "Ejes",
        "type": "number",
        "size": "small",
        "mask": "number"
      },
      {
        "name": "odometro",
        "label": "Odómetro actual (km)",
        "type": "number",
        "size": "small",
        "mask": "number"
      },
      {
        "name": "capacidadTanque",
        "label": "Tanque (galones)",
        "type": "number",
        "size": "small",
        "mask": "number"
      },
      {
        "name": "rendimientoEsperado",
        "label": "Rendimiento esperado (km/gal)",
        "type": "number",
        "size": "small",
        "mask": "number"
      },
      {
        "name": "fechaCompra",
        "label": "Fecha de compra",
        "type": "date",
        "size": "small"
      },
      {
        "name": "costoCompra",
        "label": "Costo de compra",
        "type": "money",
        "size": "small",
        "mask": "money"
      },
      {
        "name": "pilotoAsignadoId",
        "label": "Piloto asignado",
        "type": "select",
        "size": "medium",
        "optionsUrl": "/pilotos",
        "columnaDb": {
          "codigo": "id",
          "nombre": "empleado.nombres"
        }
      },
      {
        "name": "estado",
        "label": "Situación",
        "type": "select",
        "size": "small",
        "options": [
          {
            "value": "ACTIVO",
            "label": "Activo"
          },
          {
            "value": "EN_TALLER",
            "label": "En taller"
          },
          {
            "value": "INACTIVO",
            "label": "Inactivo"
          },
          {
            "value": "VENDIDO",
            "label": "Vendido"
          }
        ]
      },
      {
        "name": "notas",
        "label": "Notas",
        "type": "text",
        "size": "full",
        "placeholder": "Ingrese notas"
      }
    ]
  },
  {
    "subgrupo": "Depreciación",
    "icon": "money",
    "description": "Deje vacío lo que deba salir de su regla (Finanzas › Reglas de depreciación, por marca, tipo y año). Necesita el costo y la fecha de compra. Marque «No depreciar» si es arrendado o no debe entrar a los costos.",
    "dataField": "cabezales",
    "type": "table",
    "defaultOpen": true,
    "className": "mb-4",
    "fields": [
      {
        "name": "metodoDepreciacion",
        "label": "Método propio (vacío: el de su regla)",
        "type": "select",
        "size": "medium",
        "options": [
          {
            "value": "LINEA_RECTA",
            "label": "Línea recta"
          },
          {
            "value": "SUMA_DIGITOS",
            "label": "Suma de dígitos (más al inicio)"
          },
          {
            "value": "SALDO_DECRECIENTE",
            "label": "Saldo decreciente (más al inicio)"
          },
          {
            "value": "TABLA",
            "label": "Tabla por año (de la regla)"
          },
          {
            "value": "POR_KM",
            "label": "Por kilómetro"
          }
        ]
      },
      {
        "name": "vidaUtilAnios",
        "label": "Vida útil (años)",
        "type": "number",
        "size": "small",
        "mask": "number"
      },
      {
        "name": "vidaUtilKm",
        "label": "Vida útil (km)",
        "type": "number",
        "size": "small",
        "mask": "number"
      },
      {
        "name": "valorResidual",
        "label": "Valor residual (Q)",
        "type": "money",
        "size": "small",
        "mask": "money"
      },
      {
        "name": "kmCompra",
        "label": "Odómetro al comprar (km)",
        "type": "number",
        "size": "small",
        "mask": "number"
      },
      {
        "name": "fechaBaja",
        "label": "Fecha de venta o baja",
        "type": "date",
        "size": "small"
      },
      {
        "name": "excluirDepreciacion",
        "label": "No depreciar",
        "type": "checkbox",
        "size": "small"
      }
    ]
  }
]
