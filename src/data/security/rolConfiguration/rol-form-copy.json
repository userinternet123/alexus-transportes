{
  "module": "Gestión de permisos",
  "title": "Asigne los permisos según corresponda, Formulario-Plataforma, Formulario-Rol, Rol-Usuario",
  "section": [
    {
      "subgrupo": "Asignación de formulario a plataforma ",
      "description": "Seleccione la plataforma y administre los formularios asignados",
      "icon": "monitor",
      "defaultOpen": true,
      "className": "border-r text-blue-600 bg-slate-50",
      "type": "card",
      "fields": [
        {
          "name": "plataforma",
          "dataSource": "",
          "label": "Plataforma",
          "type": "select",
          "placeholder": "Solicitud de Nueva Tarjeta",
          "required": true,
          "size": "large",
          "entity": "usuarios",
          "options": ["Solicitudtc"]
        },

        {
          "name": "btnBuscarUsuario",
          "label": "Buscar",
          "type": "button",
          "icon": "search",
          "action": "searchUser"
        },
        {
          "name": "asignacionFormulario",
          "type": "assignment",
          "size": "full",
          "entity": "formEntity",
          "label": "Asignación de Formularios",
          "selectorDrawer": {
            "drawerTitle": "Agregar Formulario",
            "title": "Agregar Formularios a la plataforma",
            "subtitle": "Seleccione uno o varios Formularios a la ves"
          },
          "options": [
            {
              "codigo": 1,
              "nombre": "Solicitud de Nueva TC"
            },
            {
              "codigo": 2,
              "nombre": "Listado de Solicitudes"
            },
            {
              "codigo": 3,
              "nombre": "Gestión Roles"
            },
            {
              "codigo": 4,
              "nombre": "Gestión Plataforma"
            }
          ]
        }
      ]
    },
    {
      "subgrupo": "Asignación de formulario a Rol",
      "description": "Seleccione el rol y administre los formularios asignados",
      "icon": "link",
      "defaultOpen": true,
      "type": "card",
      "className": "border-r text-green-600 bg-slate-50",
      "fields": [
        {
          "name": "rol",
          "dataSource": "",
          "label": "Roles",
          "type": "select",
          "required": true,
          "size": "large",
          "entity": "roles",
          "options": ["Administrador", "Agente de agencia"]
        },
        {
          "name": "bntListarroles",
          "label": "Buscar",
          "type": "button",
          "icon": "search",
          "action": "lisRoles"
        },

        {
          "name": "formrol",
          "type": "assignment",
          "size": "full",
          "entity": "formrol",
          "label": "Asignación de Formularios",
          "selectorDrawer": {
            "drawerTitle": "Agregar Formulario",
            "title": "Agregar formularios a un rol",
            "subtitle": "Seleccione uno o varios Formularios a la ves"
          },
          "options": [
            {
              "codigo": 1,
              "nombre": "Solicitud de Nueva TC"
            },
            {
              "codigo": 2,
              "nombre": "Listado de Solicitudes"
            },
            {
              "codigo": 3,
              "nombre": "Gestión Roles"
            },
            {
              "codigo": 4,
              "nombre": "Gestión Plataforma"
            }
          ]
        }
      ]
    },
    {
      "subgrupo": "Asignación de rol a usuario",
      "description": "Seleccione el usuario y administre los roles asignados",
      "icon": "usercog",
      "type": "card",
      "defaultOpen": true,
      "className": "border-r text-violet-600 bg-slate-50",
      "fields": [
        {
          "name": "usuario",
          "label": "Usuario",
          "type": "text",
          "placeholder": "usr000000",
          "required": true,
          "size": "large",
          "entity": "usuarios"
        },
        {
          "name": "btnBuscarUsuario",
          "label": "Buscar",
          "type": "button",
          "icon": "search",
          "action": "searchUser"
        },
        {
          "name": "userCard",
          "type": "infoCard",
          "size": "full"
        },
        {
          "name": "userrol",
          "type": "assignment",
          "size": "full",
          "entity": "userrol",
          "label": "Asignación de Roles",
          "selectorDrawer": {
            "drawerTitle": "Agregar Roles",
            "title": "Agregar roles a un usuario",
            "subtitle": "Seleccione uno o varios Roles a la ves"
          },
          "options": [
            {
              "codigo": 1,
              "nombre": "Administrador"
            },
            {
              "codigo": 2,
              "nombre": "Supervisor"
            },
            {
              "codigo": 3,
              "nombre": "Jefe de Agencia"
            },
            {
              "codigo": 4,
              "nombre": "Agente"
            }
          ]
        },
        {
          "name": "label",
          "type": "label",
          "label": "Ingrese intervalo de vigencia",
          "size": "full"
        },
        {
          "name": "fechaInicioExpiracion",
          "dataSource": "",
          "label": "Fecha Inicio Vigencia",
          "type": "date",
          "size": "large",
          "entity": "fechaExpiracion"
        },
        {
          "name": "fechaFinExpiracion",
          "dataSource": "",
          "label": "Fecha Fin Vigencia",
          "type": "date",
          "size": "large",
          "entity": "fechaExpiracion"
        }
      ]
    }
  ]
}
