{
  "module": "Gestión de permisos por Rol",
  "title": "Asigne los permisos según corresponda, Permisos-Rol",
  "msg": "Seleccione el rol, agregue o quite permisos según corresponda",
  "section": [
    {
      "subgrupo": "Asignación de Permisos al Rol",
      "description": "Seleccione el rol y administre los permisos asignados",
      "icon": "link",
      "defaultOpen": true,
      "type": "card",
      "className": "border-r text-green-600 bg-slate-50",
      "fields": [
        {
          "name": "btnSearchFormRol",
          "dataSource": "",
          "label": "Roles",
          "type": "select",
          "required": true,
          "size": "large",
          "entity": "rolesDisponibles",
          "columnaDb": {
            "nombre": "nombreRol",
            "codigo": "idRol"
          }
        },

        {
          "name": "formularioRol",
          "type": "assignment",
          "size": "full",
          "keyDown": "btnSearchFormRol",
          "entity": "formulariosDisponibles",
          "label": "Asignación de Permisos",
          "selectorDrawer": {
            "drawerTitle": "Agregar Permiso",
            "title": "Agregar Permisos a un Rol",
            "subtitle": "Seleccione uno o varios Permisos a la ves",
            "camposDb": {
              "codigo": "idFormulario",
              "nombre": "nombreFormulario",
              "descripcion": "descripcionFormulario"
            }
          }
        },
        {
          "name": "btnSaveAssignments",
          "label": "Guardar Cambios",
          "type": "button",
          "icon": "save",
          "confirm": true,
          "action": "saveFormRol"
        }
      ]
    },
    {
      "subgrupo": "Listado de Asignaciones",
      "description": "Listado de permisos asignados al rol",
      "icon": "link",
      "defaultOpen": true,
      "className": "border-r text-green-600 bg-slate-50",
      "showSearch": true,
      "showPagination": true,
      "searchPlaceHolder": "Administrador, Jefe, etc.",
      "dataField": "formularioAsignado",
      "type": "table",
      "fields": [],
      "columns": [
        {
          "accessorKey": "idRol",
          "header": "ID Rol"
        },

        {
          "accessorKey": "nombreRol",
          "header": "Nombre Rol"
        },
        {
          "accessorKey": "descripcionRol",
          "header": "Descripción Rol"
        },
        {
          "accessorKey": "idFormulario",
          "header": "ID Permiso"
        },
        {
          "accessorKey": "nombreFormulario",
          "header": "Nombre del permiso"
        },

        {
          "accessorKey": "asignado_por",
          "header": "Asignado Por"
        },
        {
          "accessorKey": "fecha_asignacion",
          "header": "Fecha Asignación"
        }
      ]
    }
  ]
}
