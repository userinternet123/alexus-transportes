{
  "module": "Solicitud de Nueva Tarjeta de Crédito",
  "msg": "Los campos marcados con * son obligatorios",
  "title": "",
  "section": [
    {
      "subgrupo": "Datos Personales",
      "icon": "user",
      "description": "Ingrese y busque al cliente para autocompletar parte de la información",
      "defaultOpen": true,
      "fields": [
        {
          "name": "tipoDocumento",
          "label": "Tipo de Documento",
          "type": "radio",
          "readOnly": false,
          "size": "supersmall",
          "options": [
            {
              "value": "dpi",
              "label": "DPI/CUI",
              "default": true
            },
            { "value": "mis", "label": "MIS" },
            { "value": "pasaporte", "label": "Pasaporte" }
          ]
        },
        {
          "name": "dpi",
          "type": "text",
          "required": true,
          "readOnly": false,
          "placeholder": "0000 00000 0101",
          "mask": "dpi",
          "keyDown": "btnSearchClient",
          "size": "medium",
          "visibleWhen": {
            "name": "tipoDocumento",
            "value": "dpi",
            "showDefault": true
          }
        },
        {
          "name": "mis",
          "type": "text",
          "required": true,
          "placeholder": "0000 0000",
          "keyDown": "btnSearchClient",
          "mask": "mis",
          "readOnly": false,
          "size": "medium",
          "visibleWhen": { "name": "tipoDocumento", "value": "mis" }
        },
        {
          "name": "pasaporte",
          "type": "text",
          "required": true,
          "placeholder": "AA000000",
          "keyDown": "btnSearchClient",
          "mask": "pasaporte",
          "readOnly": false,
          "size": "medium",
          "visibleWhen": { "name": "tipoDocumento", "value": "pasaporte" }
        },
        {
          "name": "btnSearchClient",
          "label": "Buscar Cliente",
          "type": "button",
          "icon": "search",
          "required": true
        },
        { "name": "space", "type": "space", "size": "full" },
        { "name": "space2", "type": "space", "size": "full" },
        {
          "name": "label",
          "type": "label",
          "label": "Datos Personales que se autocompletarán con su Documento de Identidad"
        },
        { "name": "separator", "type": "separator", "size": "full" },
        {
          "name": "primerNombre",
          "required": true,
          "label": "Primer Nombre",
          "type": "text",
          "placeholder": "Se autocompleta",
          "readOnly": true
        },
        {
          "name": "segundoNombre",
          "label": "Segundo Nombre",
          "type": "text",
          "placeholder": "Se autocompleta",
          "readOnly": true
        },
        {
          "name": "tercerNombre",
          "label": "Tercer Nombre",
          "type": "text",
          "placeholder": "Se autocompleta",
          "readOnly": true
        },
        {
          "name": "primerApellido",
          "label": "Primer Apellido",
          "type": "text",
          "placeholder": "Se autocompleta",
          "readOnly": true
        },
        {
          "name": "segundoApellido",
          "label": "Segundo Apellido",
          "type": "text",
          "placeholder": "Se autocompleta",
          "readOnly": true
        },
        {
          "name": "estadocivilDescripcion",
          "label": "Estado Civil",
          "placeholder": "Se autocompleta",
          "type": "text",
          "readOnly": true,
          "size": "medium"
        },
        {
          "name": "profesionDescripcion",
          "label": "Profesión",
          "placeholder": "Se autocompleta",
          "type": "text",
          "readOnly": true,
          "size": "medium"
        },
        {
          "name": "direccionResidencia",
          "label": "Dirección",
          "type": "text",
          "placeholder": "Se autocompleta",
          "readOnly": true,
          "size": "full"
        }
      ]
    },
    {
      "subgrupo": "Contacto",
      "icon": "phone",
      "fields": [
        {
          "name": "telefonoCelular",
          "label": "Celular",
          "type": "text",
          "readOnly": true,
          "placeholder": "Se autocompleta",
          "mask": "phone",
          "size": "medium"
        },
        {
          "name": "telefonoCasa",
          "label": "Teléfono de casa",
          "type": "text",
          "readOnly": true,
          "placeholder": "Se autocompleta",
          "mask": "phone",
          "size": "medium"
        },
        {
          "name": "email",
          "label": "Email",
          "type": "text",
          "readOnly": true,
          "placeholder": "xxxxxxxxxxxxxx@mail.com",
          "mask": "email",
          "size": "medium"
        }
      ]
    },
    {
      "subgrupo": "Información Laboral",
      "icon": "building",
      "description": "Datos laborales registrados en Sistema",
      "dataField": "trabajos",
      "type": "table",
      "fields": [],
      "columns": [
        {
          "accessorKey": "empresaTrabajo",
          "header": "Empresa/Institución"
        },
        {
          "accessorKey": "direccionTrabajo",
          "header": "Dirección"
        },
        {
          "accessorKey": "puestoTrabajo",
          "header": "Puesto/Cargo"
        },
        {
          "accessorKey": "fechaTrabajo",
          "header": "Fecha de Inicio",
          "type": "badge"
        },
        {
          "accessorKey": "telefonoTrabajo",
          "header": "Teléfono"
        }
      ]
    },

    {
      "subgrupo": "Datos Adicionales",
      "icon": "money",
      "defaultOpen": true,
      "fields": [
        {
          "name": "ingresoServiciosProfesionales",
          "label": "Ingreso de servicios profesionales",
          "type": "text",
          "required": true,
          "placeholder": "Q. 0.00",
          "readOnly": false,
          "mask": "money",
          "size": "medium"
        },
        {
          "name": "limiteRecomendado",
          "label": "Límite recomendado",
          "type": "text",
          "placeholder": "Q. 0.00",
          "required": true,
          "readOnly": false,
          "mask": "money",
          "size": "medium"
        },
        {
          "name": "otrasFuentes",
          "label": "Otra fuente de ingresos",
          "type": "text",
          "placeholder": "Q. 0.00",
          "required": true,
          "mask": "money",
          "readOnly": false,
          "size": "medium"
        },
        {
          "name": "telefonoActual",
          "label": "Teléfono actual",
          "type": "text",
          "placeholder": "9999-9999",
          "required": true,
          "mask": "phone",
          "readOnly": false,
          "size": "medium"
        }
      ]
    },
    {
      "subgrupo": "",
      "fields": []
    }
  ]
